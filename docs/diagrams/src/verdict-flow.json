    { "id": "boot", "lane": "stats", "col": 1, "type": "backend", "label": "Paired bootstrap", "sublabel": "4000 resamples", "width": 150 },
    { "id": "hyp", "lane": "stats", "col": 2, "type": "backend", "label": "Hypothesis", "sublabel": "confirmed, refuted, underpowered", "width": 170 },
    { "id": "tier", "lane": "bar", "col": 1, "type": "security", "label": "Autonomy and consequence", "sublabel": "set the tier", "width": 196 },
    { "id": "gates", "lane": "bar", "col": 3, "type": "security", "label": "Gates", "sublabel": "sample, hazards, success, claim", "width": 170 },
    { "id": "ship", "lane": "runs", "col": 5, "type": "external", "label": "Ship", "sublabel": "every gate passed", "width": 140 },
    { "id": "hold", "lane": "stop", "col": 4, "type": "security", "label": "Hold", "sublabel": "a gate failed outright", "width": 150 },
    { "id": "more", "lane": "stop", "col": 5, "type": "messagebus", "label": "More evidence", "sublabel": "an interval is too wide", "width": 150 }
